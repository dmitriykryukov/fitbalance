# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → API Keys
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# Secret / service-role key — server only (account deletion)
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — needed from Phase 3
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# AI_FOOD_PARSER_MODEL=claude-haiku-5-5
# AI_COACH_MODEL=claude-haiku-5-5
# AI_DAILY_INSIGHT_MODEL=claude-haiku-5-5
# AI_DAILY_FOOD_PARSE_LIMIT=50
# AI_DAILY_COACH_LIMIT=30
